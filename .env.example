# URL base del backend NestJS.
# Desarrollo local:         http://localhost:3000
# Emulador Android:         http://10.0.2.2:3000   (localhost del host desde el emulador)
# Dispositivo físico en LAN: http://192.168.x.x:3000
# Producción (Railway):     https://sosagroapi.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# DSN de Sentry para reporte de errores en runtime.
# Obtener en: Sentry → Settings → Projects → <proyecto> → Client Keys (DSN)
# Dejar vacío en desarrollo local para deshabilitar Sentry.
EXPO_PUBLIC_SENTRY_DSN=
